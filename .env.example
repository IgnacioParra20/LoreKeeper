# PostgreSQL local
POSTGRES_DB=lorekeeper
POSTGRES_USER=lorekeeper
POSTGRES_PASSWORD=lorekeeper_dev
DB_PORT=5432

# API local (fuera de Docker)
DATABASE_URL=postgresql://lorekeeper:lorekeeper_dev@localhost:5432/lorekeeper?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Web local. Déjalo vacío para usar el proxy de Vite o el proxy de Nginx.
VITE_API_URL=
WEB_PORT=5173

# HTTP local: false. En un despliegue HTTPS: true y CORS_ORIGIN=https://tu-dominio.
COOKIE_SECURE=false
SESSION_ABSOLUTE_HOURS=168
SESSION_IDLE_HOURS=24
AUTH_REGISTER_LIMIT=5
AUTH_LOGIN_IP_LIMIT=20
AUTH_LOGIN_EMAIL_LIMIT=10
# Usa una base exclusiva de tests, nunca lorekeeper.
TEST_DATABASE_URL=postgresql://lorekeeper:lorekeeper_dev@localhost:5432/lorekeeper_test?schema=public
