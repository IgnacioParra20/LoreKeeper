# PostgreSQL local
POSTGRES_DB=lorekeeper
POSTGRES_USER=lorekeeper
POSTGRES_PASSWORD=lorekeeper_dev
DB_PORT=5432

# API local (fuera de Docker)
DATABASE_URL=postgresql://lorekeeper:lorekeeper_dev@localhost:5432/lorekeeper?schema=public
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Web local. Déjalo vacío para usar el proxy de Vite o el proxy de Nginx.
VITE_API_URL=
WEB_PORT=5173

